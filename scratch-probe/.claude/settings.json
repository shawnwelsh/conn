{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:3711/hooks/event", "timeout": 3 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:3711/hooks/event", "timeout": 3 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:3711/hooks/event", "timeout": 3 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "http", "url": "http://127.0.0.1:3711/hooks/event", "timeout": 3 }] }],
    "PostToolUseFailure": [{ "matcher": "*", "hooks": [{ "type": "http", "url": "http://127.0.0.1:3711/hooks/event", "timeout": 3 }] }],
    "Notification": [{ "matcher": "permission_prompt|idle_prompt", "hooks": [{ "type": "http", "url": "http://127.0.0.1:3711/hooks/event", "timeout": 3 }] }],
    "Stop": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:3711/hooks/event", "timeout": 3 }] }],
    "PreToolUse": [{ "matcher": "AskUserQuestion", "hooks": [{ "type": "http", "url": "http://127.0.0.1:3711/hooks/question", "timeout": 3 }] }],
    "PermissionRequest": [{ "matcher": "*", "hooks": [{ "type": "http", "url": "http://127.0.0.1:3711/hooks/permission-request", "timeout": 35 }] }]
  }
}
