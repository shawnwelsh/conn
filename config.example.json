{
  "port": 3711,
  "decisionTimeoutSeconds": 30,
  "slots": 5,
  "maxSessions": 15,
  "doubleTapMs": 300,
  "longPressMs": 500,
  "moveCancelSeconds": 5,
  "cmdPagerRevertSeconds": 6,
  "desktopSubmitDelayMs": 250,
  "staleSessionMinutes": 60,
  "deadSessionSweepHours": 3,
  "alwaysAllowDestination": "session",
  "delivery": {
    "adapter": "ahk",
    "ahkPath": "%LOCALAPPDATA%\\Programs\\AutoHotkey\\v2\\AutoHotkey64.exe",
    "windowMode": "activeWindow"
  },
  "commandsFile": "commands.json",
  "newSessionCommand": "claude --permission-mode plan",
  "consoleHost": "wt",
  "newSessionDir": "C:\\path\\to\\your\\main\\repo",
  "newSessionWorktrees": true,
  "worktreeTimeoutSeconds": 90,
  "suggestionAcceptText": "yes",
  "ptt": {
    "enabled": true,
    "python": "python",
    "model": "distil-small.en",
    "language": "en",
    "maxSeconds": 60,
    "reasonMaxSeconds": 10,
    "renameMaxSeconds": 10
  },
  "log": {
    "level": "info",
    "dir": "logs"
  },
  "optionReader": {
    "enabled": false,
    "model": "haiku",
    "timeoutSeconds": 25
  }
}
