{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.shawnwelsh.conn",
  "Name": "Conn",
  "Version": "0.1.0.0",
  "Author": "Shawn Welsh",
  "Description": "Physical control surface for Claude Code sessions — renders live status and permission/question answer keys from the local Conn bridge.",
  "Icon": "imgs/plugin-icon",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Nodejs": {
    "Version": "24"
  },
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Category": "Conn",
  "CategoryIcon": "imgs/plugin-icon",
  "Actions": [
    {
      "UUID": "com.shawnwelsh.conn.key",
      "Name": "Deck Key",
      "Tooltip": "Place on every key of a 3x5 profile; the bridge decides what each key shows and does based on its position.",
      "Icon": "imgs/action-icon",
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "imgs/action-icon" }
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false
    }
  ]
}
